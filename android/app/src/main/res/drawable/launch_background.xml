<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12 (#101): the helmet on the ground colour, the size the
     Android 12+ splash screen gives it (values-v31). Removed when Flutter draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground"/>
    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground"/>
</layer-list>
