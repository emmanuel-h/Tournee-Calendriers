<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (#101): the system splash screen ignores windowBackground and shows these
         instead, while the process starts with Dark Mode on. The icon is the launcher
         foreground (helmet and done badge) on the ground colour, without the street map. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
