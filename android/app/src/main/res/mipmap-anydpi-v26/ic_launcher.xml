<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon (#101). minSdk is 26, so every device takes this adaptive icon and no
     PNG mipmaps are needed; the launcher cuts the centre 72 x 72 dp of the 108 dp layers with
     its own mask. The monochrome layer is used by Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
