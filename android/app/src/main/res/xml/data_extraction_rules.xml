<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app leaves the phone through Android's backup (Android 12
     and later; older versions follow android:allowBackup="false" in the
     manifest): neither the Google cloud backup nor a transfer to a new
     phone. The app's files (« Mes secteurs », the tournée on and its dons,
     the phone's id) and Firestore's copy of the secteurs stay on this phone
     and go with the app when it is uninstalled (PRIVACY.md, #144). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
