rules_version = '2';

// Security rules of Tournée Calendriers (PLAN §8.1, §8.2).
//
// They accept exactly what the Firestore adapters write
// (lib/infrastructure/firestore/, PLAN §6.2 and « What the adapters
// write » in §8.2) and refuse everything else. Tested in the emulator by
// `npm test` (firebase/test/).
//
// How to read them:
// - A request is allowed when one `allow` of the document it touches is
//   true. A rule that hits an error (a missing field, a document that does
//   not exist) counts as false: whatever is not described is refused.
// - `resource.data` is the document as stored, `request.resource.data` the
//   document as it would be after the write.
// - In a batch or a transaction, `get` / `exists` see the database before
//   the batch, `getAfter` / `existsAfter` as it would be after it. That is
//   how a rule checks that the other documents of the batch go with it
//   (a new tournée comes with its code, its reservation and its creator).
// - The rules language has no loops. A write that changes one house, one
//   door or one field is checked field by field. Houses written in bulk (a
//   new street, « numéros en plus ») come in writes of at most
//   housesPerWrite() houses, each checked whole by a check written out once
//   per place (areAddedHouses). The doors and layout rows of a building
//   written whole are only counted (PLAN §8.2).
// - Lengths are counted in code points, as the domain counts them
//   (`characterCount`: 🚒 = 1), with a pattern: the `size()` of a string
//   counts UTF-16 units (🚒 = 2), the patterns (RE2) count code points.
// - Times (`at`, `requestedAt`…) are the phone's clock (PLAN §6.1): a mark
//   made offline reaches the server hours later and keeps its time, so
//   they are only required to be timestamps, never compared with
//   `request.time` when written. The one comparison is the 30-day purge of
//   the Corbeille, on a stored removal time (isPastRetention).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- who

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function tourneePath(tournee) {
      return /databases/$(database)/documents/tournees/$(tournee);
    }

    function memberPath(tournee, member) {
      return /databases/$(database)/documents/tournees/$(tournee)/members/$(member);
    }

    function campaignPath(tournee, year) {
      return /databases/$(database)/documents/tournees/$(tournee)/campaigns/$(year);
    }

    function joinCodePath(code) {
      return /databases/$(database)/documents/joinCodes/$(code);
    }

    function tourneeKeyPath(key) {
      return /databases/$(database)/documents/tourneeKeys/$(key);
    }

    // An accepted member: a pending one reads and writes nothing of the
    // tournée (PLAN §8.1), only their own member document.
    function isActiveMember(tournee) {
      return signedIn()
        && exists(memberPath(tournee, uid()))
        && get(memberPath(tournee, uid())).data.status == 'active';
    }

    // An administrator of the app (PLAN §5.12): an `admins/{uid}` document,
    // added by hand in the console. Admins are global: they manage every
    // tournée, member of it or not. The creator has no power of their own.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // An active member or an admin: who reads a tournée and works on its
    // streets.
    function isMemberOrAdmin(tournee) {
      return isActiveMember(tournee) || isAdmin();
    }

    // ------------------------------------------------------------ values

    // A document holding exactly [fields], no more, no fewer.
    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    // A document holding every one of [fields], and maybe some of
    // [optional], nothing else.
    function hasFields(data, fields, optional) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields.concat(optional));
    }

    // An entry of a house or a door: exactly [fields], and maybe `tries`
    // (hasTries). The same as hasFields(entry, fields, ['tries']), in
    // fewer expressions: a write of new houses checks it for each one
    // (housesPerWrite).
    function hasEntryFields(entry, fields) {
      return entry.keys().removeAll(['tries']).toSet() == fields.toSet();
    }

    // At most [max] characters, counted in code points. `(?s)`: a line
    // break counts too.
    function hasAtMost(text, max) {
      return text is string && text.matches('(?s).{0,' + string(max) + '}');
    }

    // Trimmed at both ends, possibly empty.
    function isTrimmed(text) {
      return text is string && text.matches('(?s)([^\\s](.*[^\\s])?)?');
    }

    // A name as the domain cleans it: one line, trimmed, single spaces
    // between words, 1 to [max] characters (MemberName, RescueCentre,
    // StreetName).
    function isName(text, max) {
      return hasAtMost(text, max) && text.matches('[^\\s]+( [^\\s]+)*');
    }

    // An identifier the app makes (IdGenerator, Firestore): ASCII letters
    // and digits. Checked before it is put in a path.
    function isId(text) {
      return text is string && text.matches('[A-Za-z0-9]{1,128}');
    }

    // JoinCode: 6 characters of ABCDEFGHJKMNPQRSTUVWXYZ23456789.
    function isJoinCode(code) {
      return code is string && code.matches('[A-HJKMNP-Z2-9]{6}');
    }

    // RescueCentreKey: words of a–z 0–9 joined by dashes (`villefranche-sur-saone`).
    function isCentreKey(key) {
      return key is string && key.size() <= 200 && key.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    function isTourneeNumber(number) {
      return number is int && number >= 1 && number <= 9999;
    }

    function isCampaignYear(year) {
      return year is int && year >= 2000 && year <= 2099;
    }

    // A stamp the caller makes: every change records who made it (PLAN §8.1).
    function isCallerStamp(by, at) {
      return signedIn() && by == uid() && at is timestamp;
    }

    // ----------------------------------------------------- the directory

    // `tourneeKeys/{centreKey}_{number}`: its existence reserves the number
    // in the station. Written by the creator, an admin, for the tournée's
    // own pair.
    function isReservation(key, data) {
      return isAdmin()
        && hasExactly(data, ['tourneeId'])
        && isId(data.tourneeId)
        && getAfter(tourneePath(data.tourneeId)).data.createdBy == uid()
        && key == getAfter(tourneePath(data.tourneeId)).data.centreKey + '_'
          + string(getAfter(tourneePath(data.tourneeId)).data.number);
    }

    // `joinCodes/{code}`: what « Rejoindre » shows before the request, and
    // nothing else (PLAN §8.2). Written by an admin with the tournée or a
    // new code, and it must say what the tournée says.
    function isPreview(code, data) {
      return isAdmin()
        && hasExactly(data, ['tourneeId', 'number', 'centreName', 'campaign'])
        && isId(data.tourneeId)
        && getAfter(tourneePath(data.tourneeId)).data.joinCode == code
        && data.number == getAfter(tourneePath(data.tourneeId)).data.number
        && data.centreName == getAfter(tourneePath(data.tourneeId)).data.centreName
        && data.campaign == getAfter(tourneePath(data.tourneeId)).data.currentCampaign;
    }

    // A code or a reservation goes when its tournée goes, or (a code) when
    // an admin draws a new one.
    function isFreedByAdmin(tourneeId) {
      return isAdmin() && !existsAfter(tourneePath(tourneeId));
    }

    function isCodeFreed(code, data) {
      return isAdmin()
        && (!existsAfter(tourneePath(data.tourneeId))
          || getAfter(tourneePath(data.tourneeId)).data.joinCode != code);
    }

    // `admins/{uid}`: no fields, added and removed by hand in the console,
    // never by the app. Any signed-in phone may ask whether one uid is an
    // admin (its own, or a member's « · admin »); nobody lists them.
    match /admins/{admin} {
      allow get: if signedIn();
    }

    match /rescueCentres/{centreKey} {
      // Listed by « Créer » (station names only); the first name stays.
      // Only admins create tournées, hence stations (PLAN §5.12).
      allow read: if signedIn();
      allow create: if isAdmin()
        && isCentreKey(centreKey)
        && hasExactly(request.resource.data, ['name'])
        && isName(request.resource.data.name, 80);
    }

    match /tourneeKeys/{key} {
      // `get` only: « Créer » asks whether one pair is taken.
      allow get: if signedIn();
      allow create: if signedIn() && isReservation(key, request.resource.data);
      allow delete: if isFreedByAdmin(resource.data.tourneeId);
    }

    match /joinCodes/{code} {
      // `get` only, never `list`: knowing a code is the only way to it.
      // Create only: a set over an existing code is an update, refused,
      // so no one replaces another tournée's preview.
      allow get: if signedIn();
      allow create: if signedIn() && isJoinCode(code) && isPreview(code, request.resource.data);
      allow delete: if isCodeFreed(code, resource.data);
    }

    // ------------------------------------------------------- the tournée

    function tourneeFields() {
      return ['number', 'centreKey', 'centreName', 'joinCode', 'createdBy',
        'createdAt', 'currentCampaign', 'communes'];
    }

    // The most communes a tournée covers (Tournee.maxCommunes).
    function maxCommunes() {
      return 50;
    }

    // One entry of a tournée's `communes` (#78, TourneeCommune): an INSEE
    // code, the name as geo.api.gouv.fr gives it (trimmed, not blank), and
    // its centre or nothing.
    function isCommuneEntry(entry) {
      return entry is map
        && hasExactly(entry, ['code', 'name', 'lat', 'lon'])
        && entry.code is string && entry.code.matches('([0-9]{2}|2A|2B)[0-9]{3}')
        && hasAtMost(entry.name, 100) && entry.name.size() > 0 && isTrimmed(entry.name)
        && isPosition(entry.lat, entry.lon);
    }

    // The communes of a new tournée: 1 to maxCommunes(). No loops: the
    // first entry is checked whole, the others are only counted (PLAN
    // §8.2).
    function isCommuneList(communes) {
      return communes is list
        && communes.size() >= 1 && communes.size() <= maxCommunes()
        && isCommuneEntry(communes[0]);
    }

    // Any active member or admin adds or removes one commune (Équipe,
    // `arrayUnion` / `arrayRemove` of one entry): only `communes` changes,
    // by one entry, an added one checked whole; the list never empties.
    // A tournée stored before the communes has no list: it counts as
    // empty, so its first commune can be added.
    function isCommunesChange(tournee, before, after) {
      let old = before.get('communes', []);
      let now = after.communes;
      return isMemberOrAdmin(tournee)
        && after.diff(before).affectedKeys().hasOnly(['communes'])
        && now is list
        && now.size() >= 1 && now.size() <= maxCommunes()
        && ((now.size() == old.size() + 1 && now.hasAll(old)
            && isCommuneEntry(now.removeAll(old)[0]))
          || (now.size() == old.size() - 1 && old.hasAll(now)));
    }

    // Created by an admin in one batch with its reservation, its code, its
    // creator (already active) and its first campaign (PLAN §8.2): the
    // reservation can only be created if absent, which makes number +
    // station unique.
    function isNewTournee(tournee, data) {
      return isAdmin()
        && hasExactly(data, tourneeFields())
        && isTourneeNumber(data.number)
        && isCentreKey(data.centreKey)
        && isName(data.centreName, 80)
        && isJoinCode(data.joinCode)
        && data.createdBy == uid()
        && data.createdAt is timestamp
        && isCampaignYear(data.currentCampaign)
        && isCommuneList(data.communes)
        && getAfter(tourneeKeyPath(data.centreKey + '_' + string(data.number))).data.tourneeId == tournee
        && getAfter(joinCodePath(data.joinCode)).data.tourneeId == tournee
        && getAfter(memberPath(tournee, uid())).data.status == 'active'
        && existsAfter(campaignPath(tournee, string(data.currentCampaign)));
    }

    // A new code (admins only, member or not): the new code document comes
    // with it and the old one goes, in the same transaction.
    function isNewCode(tournee, before, after) {
      return isAdmin()
        && after.diff(before).affectedKeys().hasOnly(['joinCode'])
        && isJoinCode(after.joinCode)
        && getAfter(joinCodePath(after.joinCode)).data.tourneeId == tournee
        && !existsAfter(joinCodePath(before.joinCode));
    }

    // Deleting (admins only, member or not) is the last batch: the code
    // and the reservation go with the tournée, after its campaigns and
    // streets, with whichever member documents remain (there may be none:
    // everyone may leave, PLAN §8.2). The rules cannot list the members,
    // so they do not check that every one goes.
    function isTourneeDeletion(data) {
      return isAdmin()
        && !existsAfter(joinCodePath(data.joinCode))
        && !existsAfter(tourneeKeyPath(data.centreKey + '_' + string(data.number)));
    }

    // ------------------------------------------------------- the members

    function memberFields() {
      return ['displayName', 'status', 'requestedAt', 'acceptedBy', 'acceptedAt'];
    }

    // A newcomer's request: pending, with the code they used, which must
    // be the tournée's current code (they cannot read the tournée).
    function isJoinRequest(tournee, data) {
      return hasExactly(data, memberFields().concat(['joinCode']))
        && isName(data.displayName, 30)
        && data.status == 'pending'
        && data.requestedAt is timestamp
        && data.acceptedBy == null
        && data.acceptedAt == null
        && data.joinCode == get(tourneePath(tournee)).data.joinCode;
    }

    // An admin's own document, active at once and accepted by themself,
    // without a code: the creator's, written with the tournée, or an admin
    // joining a tournée they are not in (« Rejoindre », PLAN §5.12).
    function isAdminMembership(data) {
      return isAdmin()
        && hasExactly(data, memberFields())
        && isName(data.displayName, 30)
        && data.status == 'active'
        && data.requestedAt is timestamp
        && data.acceptedBy == uid()
        && data.acceptedAt is timestamp;
    }

    // Any active member or admin accepts a pending one: status, who and
    // when only.
    function isAcceptance(tournee, before, after) {
      return isMemberOrAdmin(tournee)
        && before.status == 'pending'
        && after.diff(before).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
        && after.status == 'active'
        && after.acceptedBy == uid()
        && after.acceptedAt is timestamp;
    }

    // An active member renames themself (« Prénom », PLAN §5.9): their own
    // document, the name only, cleaned as MemberName cleans it.
    function isRename(tournee, member, before, after) {
      return member == uid()
        && isActiveMember(tournee)
        && after.diff(before).affectedKeys().hasOnly(['displayName'])
        && isName(after.displayName, 30);
    }

    // Refuse or cancel a request; remove (an admin, any member, admins
    // included) or leave (the member, the creator too, even the last one)
    // an active one (PLAN §5.12).
    function isMemberDeletion(tournee, member, data) {
      return signedIn() && (
        member == uid()
        || isAdmin()
        || (data.status == 'pending' && isActiveMember(tournee)));
    }

    // ------------------------------------------------------- the streets

    function streetFields() {
      return ['name', 'communeName', 'communeCode', 'banId', 'deletedAt',
        'deletedBy', 'houses'];
    }

    // The fields every house entry has; `tries` is added from the first
    // try with nobody home (hasTries).
    function houseFields() {
      return ['n', 'sfx', 'lat', 'lon', 'status', 'comeBack', 'by', 'at',
        'deletedAt', 'deletedBy'];
    }

    function buildingFields() {
      return ['labelStyle', 'layout', 'dwellings'];
    }

    // The four statuses, under the names the mapper stores. A pattern
    // rather than `in [list]`: each item of a list is an expression
    // evaluated, and a write of new houses checks several (housesPerWrite).
    function isStatus(status) {
      return status is string && status.matches('TO_DO|DONE|NOBODY_HOME|COME_BACK');
    }

    // When to come back (ComeBack, #81, come_back_text.dart): "" for no
    // time set, a day "2026-10-24", or a day and an hour of 8 to 21
    // "2026-10-24T18". Structured, not free text: nothing about the people
    // living there can be kept about a house, there is no `note` field
    // anywhere either (PLAN §8.3). The free hint of before #81 is refused
    // in a write; one already stored is only replaced when the house is
    // next written whole or marked.
    function isComeBackTime(text) {
      return text is string
        && text.matches('(2[0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(T(0[89]|1[0-9]|2[01]))?)?');
    }

    // A single house or a door has a time exactly when it is « repasser ».
    function hasMarks(entry) {
      return isStatus(entry.status)
        && (entry.status == 'COME_BACK' ? isComeBackTime(entry.comeBack) : entry.comeBack == null)
        && hasTries(entry);
    }

    // The tries with nobody home (#80, NobodyHomeTries): written only from
    // the first try, 1 to 99. Not tied to the status: an app older than
    // the tries leaves them as they were when it marks a house, and the
    // domain reads them through the status (none when to do, at least one
    // when nobody is home), so such a write stays harmless and accepted.
    function hasTries(entry) {
      return !('tries' in entry)
        || (entry.tries is int && entry.tries >= 1 && entry.tries <= 99);
    }

    function isPosition(lat, lon) {
      return (lat == null && lon == null)
        || (lat is number && lon is number
          && lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180);
    }

    // A building is to do itself, its doors carry the statuses, and it
    // may have a « repasser » of its own. Its doors are counted, not
    // checked one by one: at most 500 doors, 26 staircases of floors 0–50.
    function isBuilding(house) {
      return house.status == 'TO_DO'
        && (house.comeBack == null || isComeBackTime(house.comeBack))
        && hasTries(house)
        && house.labelStyle in ['FLOOR_AND_NUMBER', 'FLOOR_AND_LETTER', 'FREE']
        && house.layout is list && house.layout.size() >= 1 && house.layout.size() <= 26 * 51
        && house.dwellings is map && house.dwellings.size() >= 1 && house.dwellings.size() <= 500;
    }

    // A whole entry of the `houses` map (houseEntry in the mapper). Its
    // stamps are checked where a write sets them.
    function isHouse(house) {
      return house is map
        && (('layout' in house)
          ? hasEntryFields(house, houseFields().concat(buildingFields())) && isBuilding(house)
          : hasEntryFields(house, houseFields()) && hasMarks(house))
        && house.n is int && house.n >= 0 && house.n <= 99999
        && (house.sfx == null || (house.sfx is string && house.sfx.matches('[a-z][a-z0-9]{0,15}')))
        && isPosition(house.lat, house.lon);
    }

    // The key of a house is its number's label (HouseNumber.label):
    // `12`, `12bis`, `3A`. The Latin multiplicatives as a pattern, as in
    // isStatus.
    function labelOf(house) {
      return house.sfx == null
        ? string(house.n)
        : string(house.n) + (house.sfx.matches('bis|ter|quater|quinquies|sexies|septies|octies|nonies|decies')
          ? house.sfx
          : house.sfx.upper());
    }

    // A door entry (dwellingEntry in the mapper). Its stamp is the
    // caller's (isOneDoorEdited).
    function isDoor(door) {
      return door is map
        && hasFields(door, ['status', 'comeBack', 'by', 'at'], ['tries'])
        && hasMarks(door);
    }

    // Sending a street to the Corbeille (the caller's stamp) or bringing
    // it back (null).
    function isRemovalStamp(data) {
      return (data.deletedAt == null && data.deletedBy == null)
        || isCallerStamp(data.deletedBy, data.deletedAt);
    }

    // The same for a number, and one more case: the undo of « Restaurer »
    // puts back the removal it undoes, which may be a teammate's (PLAN
    // §6.2). Then it must name an active member of the tournée, or an
    // admin, who may have removed it without being in the team.
    function isNumberRemoval(tournee, house) {
      return isRemovalStamp(house)
        || (isId(house.deletedBy)
          && house.deletedAt is timestamp
          && (get(memberPath(tournee, house.deletedBy)).data.status == 'active'
            || exists(/databases/$(database)/documents/admins/$(house.deletedBy))));
    }

    // The 30-day purge of the Corbeille (PLAN §5.11; `isPastRetention` in
    // lib/domain/street/corbeille_retention.dart): a street or a number
    // removed more than 30 days before the server's time may go for good.
    // What was removed recently, or restored meanwhile, cannot.
    // `deletedAt` is the phone's time, so a member may backdate it and
    // purge at once: an accepted risk (PLAN §8.2, #85).
    function isPastRetention(item) {
      return item.deletedAt is timestamp
        && item.deletedAt < request.time - duration.value(30, 'd');
    }

    // What the map added to a street (T3.3): where it runs and who covers
    // it. Optional, so a street written by an app of before the map is
    // still accepted; read as no shape and nobody.
    function mapFields() {
      return ['shape', 'assignees'];
    }

    // A shape: one encoded polyline per piece of road, written once, with
    // the street or later (#92), never replaced. Counted, not checked line
    // by line (no loops); a street has a few dozen pieces at most.
    function isShape(shape) {
      return shape is list && shape.size() <= 1000;
    }

    // The shape of a street that had none, found after it was added
    // (#92): the `shape` field alone, while the stored one is absent (a
    // street of before the map) or empty, with at least one line. So a
    // shape is set once: two phones finding it at once cannot replace
    // each other's.
    function isShapeFill(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['shape'])
        && before.get('shape', []) == []
        && isShape(after.shape)
        && after.shape.size() >= 1
        && after.shape[0] is string;
    }

    // A new street (imported from the BAN, typed in, or moved from the
    // phone, PLAN §6.2): out of the Corbeille. It comes with its first
    // houses, at most housesPerWrite(), each checked whole; the adapter
    // sends the others in updates of as many (isHousesChange), so a
    // teammate may see it partly filled for a moment. Nobody covers it, or
    // only the caller (« Ajouter et me l'attribuer »).
    function isNewStreet(data) {
      return data.keys().hasAll(streetFields())
        && data.keys().hasOnly(streetFields().concat(mapFields()))
        && (!('shape' in data) || isShape(data.shape))
        && (!('assignees' in data) || data.assignees == [] || data.assignees == [uid()])
        && isName(data.name, 150)
        && hasAtMost(data.communeName, 150) && isTrimmed(data.communeName) && data.communeName != ''
        && data.communeCode is string && data.communeCode.matches('([0-9]{2}|2A|2B)[0-9]{3}')
        && (data.banId == null || (data.banId is string && data.banId.size() >= 1 && data.banId.size() <= 100))
        && data.deletedAt == null && data.deletedBy == null
        && data.houses is map
        && areAddedHouses(data.houses, data.houses.keys());
    }

    // A change of a street (the table of PLAN §6.2): its name, its
    // deletion (Corbeille), who covers it, or its houses. The commune and
    // the BAN id never change; the shape only by [isShapeFill].
    function isStreetChange(tournee, before, after) {
      return after.diff(before).affectedKeys().hasOnly(['name', 'deletedAt', 'deletedBy', 'houses', 'assignees'])
        && (after.name == before.name || isName(after.name, 150))
        && (after.get('assignees', []) == before.get('assignees', [])
          || isOwnAssignment(before.get('assignees', []), after.assignees))
        && ((after.deletedAt == before.deletedAt && after.deletedBy == before.deletedBy)
          || isRemovalStamp(after))
        && (after.houses == before.houses || isHousesChange(tournee, before.houses, after.houses));
    }

    // The caller takes the street (`arrayUnion`) or stops covering it
    // (`arrayRemove`), for themself only: the others who cover it stay,
    // and nobody is put on a street or taken off it by someone else.
    function isOwnAssignment(old, new) {
      return new is list
        && new.size() == new.toSet().size()
        && (new.toSet() == old.toSet().union([uid()].toSet())
          || new.toSet() == old.toSet().difference([uid()].toSet()));
    }

    // What a write may do to the `houses` map: change one house in place,
    // move one house to a new number, add houses (« numéros en plus », or
    // the houses of a new street after its first write), or drop one house
    // of the Corbeille past its 30 days (the purge). Restoring or purging
    // several numbers is sent one write per number by the adapter, so each
    // is checked.
    function isHousesChange(tournee, before, after) {
      let changes = after.diff(before);
      let changed = changes.changedKeys().size();
      let added = changes.addedKeys().size();
      let removed = changes.removedKeys().size();
      return (changed == 1 && added == 0 && removed == 0
          && isOneHouseEdited(tournee, before.values().removeAll(after.values()),
            after.values().removeAll(before.values())))
        || (changed == 0 && added == 1 && removed == 1
          && isMovedHouse(after.keys().removeAll(before.keys())[0], after))
        || (changed == 0 && removed == 0 && added >= 1
          && areAddedHouses(after, after.keys().removeAll(before.keys())))
        || (changed == 0 && added == 0 && removed == 1
          && isPastRetention(before[before.keys().removeAll(after.keys())[0]]));
    }

    // The rules cannot name the key that changed (a set has no index), so
    // the house is found by its value: the one old entry no longer there,
    // the one new entry not there before. Two entries never hold the same
    // value: each holds its own number.
    function isOneHouseEdited(tournee, olds, news) {
      return olds.size() == 1 && news.size() == 1 && isHouseEdit(tournee, olds[0], news[0]);
    }

    function isHouseEdit(tournee, old, new) {
      let fields = new.diff(old).affectedKeys();
      return (fields.hasOnly(['deletedAt', 'deletedBy']) && isNumberRemoval(tournee, new))
        || (fields.hasOnly(['dwellings'])
          && isOneDoorEdited(old.dwellings, new.dwellings))
        || (fields.hasOnly(['status', 'comeBack', 'tries', 'by', 'at'].concat(buildingFields()))
          && isHouse(new)
          && isCallerStamp(new.by, new.at));
    }

    // One door marked, its time set, or put back by an undo: the door
    // entry is whole and carries the caller's stamp. Found by its value,
    // as a house is: the new door carries its own stamp.
    function isOneDoorEdited(old, new) {
      let changes = new.diff(old);
      let doors = new.values().removeAll(old.values());
      return changes.affectedKeys().size() == 1
        && changes.changedKeys().size() == 1
        && doors.size() == 1
        && isDoor(doors[0])
        && isCallerStamp(doors[0].by, doors[0].at);
    }

    // A house moved to its new number (renumbering, or its undo): written
    // whole under its own label, shown (not in the Corbeille), stamped by
    // the caller.
    function isMovedHouse(key, houses) {
      let house = houses[key];
      return isHouse(house)
        && key == labelOf(house)
        && house.deletedAt == null && house.deletedBy == null
        && isCallerStamp(house.by, house.at);
    }

    // The most houses one write may add: `housesPerWrite` of the adapter
    // (lib/infrastructure/firestore/mappers/street_writes.dart), which
    // sends a new street and « numéros en plus » in writes of that many.
    //
    // Why 2: a request may evaluate at most 1 000 expressions, and the
    // rules count every name, value, operator and call. Checking one house
    // whole costs about 200 of them (300 for the costliest: a building
    // with a suffix, tries and a « repasser » time, marked and removed by
    // the caller), on top of about 300 for the membership, the tournée and
    // the street. Measured in the emulator (#70): two of the costliest
    // houses in a new street leave about 90 to spare, three do not fit.
    // The tests write full writes of the costliest houses, so a change
    // that makes them too dear fails there.
    function housesPerWrite() {
      return 2;
    }

    // A house a write adds under [key] (a number added, a house of a new
    // street): whole and valid, under its own label. Marked or in the
    // Corbeille only by the caller: a street moved from the phone comes
    // stamped with the caller's uid (`Street.restampedBy`). Without a
    // stamp it is a house as the BAN or « numéros en plus » give it: to do,
    // no tries, not a building. Its doors and layout rows are only counted
    // (isBuilding).
    //
    // The stamps are written out rather than through isRemovalStamp and
    // isCallerStamp, and the unmarked case comes first: it saves the
    // expressions of their calls, for each house. The membership checked
    // before this ensures the caller is signed in.
    function isAddedHouse(key, house) {
      return isHouse(house)
        && key == labelOf(house)
        && ((house.deletedBy == null && house.deletedAt == null)
          || (house.deletedBy == request.auth.uid && house.deletedAt is timestamp))
        && ((house.by == null && house.at == null
            && house.status == 'TO_DO' && !('tries' in house) && !('layout' in house))
          || (house.by == request.auth.uid && house.at is timestamp));
    }

    // The house of [keys] at [index], when [keys] has one.
    function isAddedHouseAt(houses, keys, index) {
      return keys.size() <= index || isAddedHouse(keys[index], houses[keys[index]]);
    }

    // The houses of [houses] under [keys]: at most housesPerWrite(), each
    // checked whole. The rules have no loops, so there is one line per
    // house, as many as housesPerWrite() says.
    function areAddedHouses(houses, keys) {
      return keys.size() <= housesPerWrite()
        && isAddedHouseAt(houses, keys, 0)
        && isAddedHouseAt(houses, keys, 1);
    }

    match /tournees/{tournee} {
      // A member reaches a tournée by its id, from its code; only admins
      // list them all (« Toutes les tournées », PLAN §5.12).
      allow get: if isMemberOrAdmin(tournee);
      allow list: if isAdmin();
      allow create: if isNewTournee(tournee, request.resource.data);
      allow update: if isNewCode(tournee, resource.data, request.resource.data)
        || isCommunesChange(tournee, resource.data, request.resource.data);
      allow delete: if isTourneeDeletion(resource.data);

      match /members/{member} {
        // A pending newcomer reads their own document (« Demande envoyée »
        // follows it), and nothing else.
        allow get: if (signedIn() && member == uid()) || isMemberOrAdmin(tournee);
        allow list: if isMemberOrAdmin(tournee);
        allow create: if signedIn() && member == uid()
          && (isJoinRequest(tournee, request.resource.data)
            || isAdminMembership(request.resource.data));
        allow update: if isAcceptance(tournee, resource.data, request.resource.data)
          || isRename(tournee, member, resource.data, request.resource.data);
        allow delete: if isMemberDeletion(tournee, member, resource.data);
      }

      match /campaigns/{year} {
        allow read: if isMemberOrAdmin(tournee);
        // The first campaign, written by the creator (an admin) with the
        // tournée. A new campaign (v1.1) extends this rule when it is
        // written.
        allow create: if isAdmin()
          && hasExactly(request.resource.data, ['startedAt', 'previousYear'])
          && request.resource.data.startedAt is timestamp
          && request.resource.data.previousYear == null
          && getAfter(tourneePath(tournee)).data.createdBy == uid()
          && year == string(getAfter(tourneePath(tournee)).data.currentCampaign);
        allow delete: if isAdmin();

        match /streets/{street} {
          allow read: if isMemberOrAdmin(tournee);
          // Previous campaigns are read-only.
          allow create: if isMemberOrAdmin(tournee)
            && year == string(get(tourneePath(tournee)).data.currentCampaign)
            && isNewStreet(request.resource.data);
          allow update: if isMemberOrAdmin(tournee)
            && year == string(get(tourneePath(tournee)).data.currentCampaign)
            && (isStreetChange(tournee, resource.data, request.resource.data)
              || isShapeFill(resource.data, request.resource.data));
          // A street goes to the Corbeille by an update. Hard deletion goes
          // with the tournée (an admin), or is the 30-day purge, which any
          // active member's or admin's app makes (no server, PLAN §5.11).
          allow delete: if isAdmin()
            || (isMemberOrAdmin(tournee)
              && year == string(get(tourneePath(tournee)).data.currentCampaign)
              && isPastRetention(resource.data));
        }
      }
    }
  }
}
